ntent":[{"type":"text","text":"Each node type renders with a default view designed to look reasonable out of the box:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Node","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Default rendering","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Document","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"LazyVStack","type":"codeVoice"},{"text":" of its child nodes.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Paragraph","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Text","type":"codeVoice"},{"text":" with inline marks; a lone image paragraph renders as the image.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Heading","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"Text","type":"codeVoice"},{"text":" sized by heading level (","type":"text"},{"code":"largeTitle","type":"codeVoice"},{"text":" … ","type":"text"},{"code":"subheadline","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":" carrying its inline marks.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Bullet \/ Ordered list","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Indented rows with depth-aware bullets or numbers.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Blockquote","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"A leading accent bar beside the quoted content.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Code block","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Monospaced ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" on a rounded, tinted background.","type":"text"}]}